#include "ui/menudef.h"
#include "ui/menumacros.h"

#define WINDOW_X 16
#define WINDOW_Y 16
#define WINDOW_WIDTH 390
#define WINDOW_HEIGHT 240
#define GROUP_NAME "grpBombasOptions"

menuDef {
    name "ingame_bombas"
    visible 0
    fullscreen 0
    rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    style WINDOW_STYLE_FILLED
    onEsc { close ingame_bombas ; open ingame_main }

    WINDOW( "BOMBAS", 50 )
    SUBWINDOW( 8, 32, WINDOW_WIDTH-16, 166, "VIDEO OPTIONS" )
    YESNO( 14, 61, WINDOW_WIDTH-28, 21, "Video effects:", .25, 9, "cg_bombasEventsVideo", "Enable or disable event clips. Audio continues when disabled." )
    YESNO( 14, 92, WINDOW_WIDTH-28, 21, "Voice chat video:", .25, 9, "cg_bombasVoiceVideo", "Show optional video for voice messages. Audio always plays." )
    MULTI( 14, 123, WINDOW_WIDTH-28, 21, "Video size:", .25, 9, "cg_bombasVideoScale", cvarFloatList { "50%" 50 "75%" 75 "100%" 100 "125%" 125 }, "Local video size; 100% is the default." )
    BUTTONEXT( 14, 206, WINDOW_WIDTH-28, 20, "Back", .28, 14, close ingame_bombas ; open ingame_main, tooltip "Return to the game menu" )
}
