// R87 Winchester M1897 - only ET:Legacy, not Jaymod's original M97.
if (GetModName() != "legacy") { return; }

WEAPON.BOMBAS_M1897 = 77;
this.Name = "Bombas Winchester M1897";
this.WeaponId = WEAPON.BOMBAS_M1897;

// Server-authoritative hitscan: normal bot aim/LOS/reaction times.
// Close-range shotgun; the pistol is preferable far away.
this.PrimaryFire.DefaultDesirability = 0.08;
this.PrimaryFire.SetDesirabilityRange(0, 192, 0.65);
this.PrimaryFire.SetDesirabilityRange(192, 420, 0.33);
this.PrimaryFire.SetDesirabilityRange(420, 12000, 0.03);
this.PrimaryFire.LowAmmoThreshold = 2;
this.PrimaryFire.LowAmmoPriority = 0.65;
this.PrimaryFire.LowAmmoGetAmmoAmount = 8;
